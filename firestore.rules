rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /stockRecords/{id} {
      allow read, write: if true;
    }

    match /stickerActualStock/{id} {
      allow read, write: if true;
    }

    match /visaRecords/{id} {
      allow read, write: if true;
    }

    match /dailyTeamOperations/{id} {
      allow read, write: if true;
    }

    match /settings/{id} {
      allow read, write: if true;
    }

    match /users/{id} {
      allow read, write: if true;
    }

    match /categories/{id} {
      allow read, write: if true;
    }

    match /officers/{id} {
      allow read, write: if true;
    }
  }
}
